{
  "name": "@axs/api",
  "version": "0.1.0",
  "private": true,
  "description": "AXS Diagnostic Lab REST API on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production",
    "db:migrations:list": "wrangler d1 migrations list DB --local",
    "owner:create": "node scripts/create-owner.mjs"
  },
  "dependencies": {
    "@axs/shared": "*",
    "hono": "4.13.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "5.20261125.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.168.0"
  }
}
